# DialX 网关：固定单 worker。后台无需登录，能访问后台的人可修改账号和读取日志。
# 默认仅本机监听；不要将已加载真实账号的后台直接暴露到公网。
HOST=127.0.0.1
PORT=8000

# 仅保护 /v1/* 的单一调用 Key；默认 123456。修改后重启。
# 不支持逗号/分号/竖线分隔的多个 Key；后台不会读取或修改此秘密值。
API_TOKEN=123456

# 默认模型使用上游目录的完整 ID；空值自动选择可聊天的上游默认模型。
DEFAULT_MODEL=''
MODEL_CACHE_TTL=3600

# 上游读取/连接超时（秒）；429 Retry-After 大于冷却值时优先采用。
UPSTREAM_TIMEOUT=120
CONNECT_TIMEOUT=15
COOLDOWN_SECONDS=60
# 所有健康账号忙时最多等待的秒数；0 表示不等待。
ACCOUNT_WAIT_SECONDS=2

# 完整请求正文和推理保存于服务器日志。浏览器刷新不删除服务器日志。
LOG_RETENTION_DAYS=7
# 相对路径基于 .env 所在目录；默认 data，不应置于静态目录。
DATA_DIR=data
MAX_FRAME_BYTES=2097152
MAX_RESPONSE_BYTES=16777216

# 工具绑定未验证，必须保持空数组；非空值会被拒绝。
DIALX_ENABLED_TOOLSETS='[]'

# 首次导入：复制本人 Network /api/models 请求中的 Cookie。
# 仅保留 __Secure-next-auth.session-token 或 .0/.1/... 连续完整分块。
# 支持 Cookie: 前缀；各账号用 ||| 或引号内真实换行分隔；不接受密码。
# 示例（仅说明格式，不要取消注释）：
# DIALX_COOKIES='__Secure-next-auth.session-token.0=example-part-zero; __Secure-next-auth.session-token.1=example-part-one|||__Secure-next-auth.session-token=example-other-session'
# 初始化会原子转换为下方规范记录并清空导入项，避免删除账号后重启复活。
DIALX_COOKIES=''

# 以下由程序维护：记录含稳定 id、generation、cookie 和 created_at。
# Cookie 续期只更新 cookie，不改变 id/代次或停用关系。不要手动复制旧代次。
DIALX_ACCOUNTS='[]'
# 停用账号的稳定 ID 数组；例如 ["acc_example"]，不使用索引或 Cookie 片段。
COGITO_DISABLED='[]'

# .env 中已有受管理值优先于启动环境；仅缺失值在初始化时导入环境变量。
# 文件以 0600 原子替换；保留无关配置项，禁用 ${VAR} 插值。
